<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NBMS.Studio.App.ViewModels"
        xmlns:controls="using:NBMS.Studio.App.Controls"
        x:Class="NBMS.Studio.App.Views.MainWindow"
        Width="1320"
        Height="860"
        MinWidth="1040"
        MinHeight="700"
        Title="NBMS Studio">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <DockPanel Background="#28252dc5">
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル">
        <MenuItem Header="NBMSを開く..." Click="OpenNbms_Click" />
        <MenuItem Header="BMSフォルダから一括変換..." Click="ConvertBms_Click" />
        <Separator />
        <MenuItem Header="保存" Click="Save_Click" />
        <MenuItem Header="配布パッケージを作成..." Click="ExportPackage_Click" />
        <Separator />
        <MenuItem Header="終了" Click="Exit_Click" />
      </MenuItem>
      <MenuItem Header="編集">
        <MenuItem Header="ノーツを追加" Click="AddNote_Click" IsEnabled ="False"/>
        <MenuItem Header="選択ノーツへ反映" Click="ApplyNote_Click" IsEnabled= "False"/>
        <MenuItem Header="選択ノーツを削除" Click="DeleteNote_Click" IsEnabled = "False"/>
        <Separator />
        <MenuItem Header="Set LN" Click="SetLongNote_Click" IsEnabled="{Binding CanEditSelectedNote}" />
        <MenuItem Header="Clear LN" Click="ClearLongNote_Click" IsEnabled="{Binding CanEditSelectedNote}" />
        <MenuItem Header="Set CN" Click="SetChargeNote_Click" IsEnabled="{Binding CanEditSelectedNote}" />
        <MenuItem Header="Set HCN" Click="SetHellChargeNote_Click" IsEnabled="{Binding CanEditSelectedNote}" />
        <MenuItem Header="Set Mine" Click="SetMineNote_Click" IsEnabled="{Binding CanEditSelectedNote}" />
        <MenuItem Header="Set Invisible" Click="SetInvisibleNote_Click" IsEnabled="{Binding CanEditSelectedNote}" />
        <Separator />
        <MenuItem Header="Undo" Click="Undo_Click" IsEnabled="{Binding CanUndoEditorCommand}" />
        <MenuItem Header="Redo" Click="Redo_Click" IsEnabled="{Binding CanRedoEditorCommand}" />
        <Separator />
        <MenuItem Header="Copy" Click="Copy_Click" />
        <MenuItem Header="Paste" Click="Paste_Click" IsEnabled="{Binding CanPasteEditorObject}" />
      </MenuItem>
      <MenuItem Header="表示">
        <MenuItem Header="タイムライン" IsEnabled="False" />
        <MenuItem Header="ノーツ表" IsEnabled="False" />
        <MenuItem Header="音源一覧" IsEnabled="False" />
        <MenuItem Header="参照切れチェック" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="設定">
        <MenuItem Header="グリッド設定（未実装）" IsEnabled="False" />
        <MenuItem Header="レーン設定（未実装）" IsEnabled="False" />
        <MenuItem Header="拡張モジュール設定（未実装）" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="外部ビューワ">
        <MenuItem Header="MonoGame Viewerを開く" Click="MonoGameViewer_Click" />
        <Separator />
        <MenuItem Header="MonoGame Viewerのパスを設定..." Click="SetMonoGameViewerPath_Click" />
      </MenuItem>
      <MenuItem Header="ヘルプ">
        <!-- 
        <MenuItem Header="実装状況" Click="ShowStatus_Click" />
        <MenuItem Header="NBMS Studioについて" Click="About_Click" />
        -->
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Background="#242933" Padding="8">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,24,*">
        <Button Grid.Column="0" Content="開く" Click="OpenNbms_Click" MinWidth="72" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="BMS一括変換" Click="ConvertBms_Click" MinWidth="112" Margin="0,0,8,0" />
        <Button Grid.Column="2" Content="保存" Click="Save_Click" MinWidth="72" Margin="0,0,8,0" />
        <Button Grid.Column="3" Content=".nbmp作成" Click="ExportPackage_Click" MinWidth="104" Margin="0,0,8,0" />
        <Button Grid.Column="4" Content="MonoGame(Viewer)" Click="MonoGameViewer_Click" MinWidth="96">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="MonoGame Viewerを開く" Click="MonoGameViewer_Click" />
              <MenuItem Header="MonoGame Viewerのパスを設定..." Click="SetMonoGameViewerPath_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <TextBlock Grid.Column="6"
                   Text="{Binding StatusText}"
                   Foreground="#e5e7eb"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#619dec" Padding="8">
      <TextBlock Text="{Binding ProjectPathText}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid RowDefinitions="*" ColumnDefinitions="270,*" Margin="8">
      <Border Grid.Row="0" Grid.Column="0" Background="#61796b5b" BorderBrush="#61b8a9af" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="プロジェクト" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ChartSummaryText}" Foreground="#f2f2f2" />
            <TextBlock Text="編集/再生する譜面" Foreground="#e4e9f3" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding Charts}"
                      SelectedItem="{Binding SelectedChartRow, Mode=TwoWay}"
                      SelectionChanged="ChartSelectionChanged"
                      MinHeight="30"
                      HorizontalAlignment="Stretch" />
          </StackPanel>

          <Grid Grid.Row="1" ColumnDefinitions="76,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TitleText}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Artist" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ArtistText}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Genre" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding GenreText}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="BPM" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BpmText}" />
          </Grid>

          <TabControl Grid.Row="2">
            <TabItem Header="Charts">
              <DataGrid ItemsSource="{Binding Charts}"
                        SelectedItem="{Binding SelectedChartRow, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80" />
                  <DataGridTextColumn Header="Name" Binding="{Binding LevelName}" Width="*" />
                  <DataGridTextColumn Header="Lv" Binding="{Binding Difficulty}" Width="42" />
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
            <TabItem Header="{Binding EventSummaryText}">
              <ListBox ItemsSource="{Binding Events}"
                       SelectedItem="{Binding SelectedEventRow, Mode=TwoWay}"
                       SelectionChanged="EventSelectionChanged"
                       Background="White"
                       Foreground="#111827" />
            </TabItem>
            <TabItem Header="{Binding IssueSummaryText}">
              <Grid RowDefinitions="*,Auto">
                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Issues}"
                          SelectedItem="{Binding SelectedIssueRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="62" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="72" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <Button Grid.Row="1"
                        Content="Fix with selected audio"
                        Click="RepairSelectedMissingAudioReference_Click"
                        IsEnabled="{Binding CanRepairMissingAudioReference}"
                        Margin="0,6,0,0" />
              </Grid>
            </TabItem>
            <TabItem Header="{Binding AudioSummaryText}">
              <Grid RowDefinitions="*,Auto,Auto">
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding AudioEntries}"
                         SelectedItem="{Binding SelectedAudioRow, Mode=TwoWay}"
                         Background="White"
                         Foreground="#111827" />
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,6,0,0">
                  <Button Content="Add" Click="AddAudioAsset_Click" Margin="0,0,4,4" />
                  <Button Content="Rename" Click="RenameAudioAsset_Click" IsEnabled="{Binding CanEditSelectedAudio}" Margin="4,0,0,4" />
                  <Button Content="Delete" Click="DeleteAudioAsset_Click" IsEnabled="{Binding CanEditSelectedAudio}" Margin="0,4,4,0" />
                  <Button Content="Remove unused" Click="RemoveUnusedAudioAssets_Click" Margin="4,4,0,0" />
                </UniformGrid>
                <Button Grid.Row="2"
                        Content="Preview selected audio"
                        Click="PreviewSelectedAudio_Click"
                        IsEnabled="{Binding CanPreviewSelectedAudio}"
                        Margin="0,6,0,0" />
              </Grid>
            </TabItem>
            <TabItem Header="{Binding MediaSummaryText}">
              <Grid RowDefinitions="*,Auto">
                <ListBox Grid.Row="0"
                         ItemsSource="{Binding MediaAssetEntries}"
                         SelectedItem="{Binding SelectedMediaAssetRow, Mode=TwoWay}"
                         Background="White"
                         Foreground="#111827" />
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,6,0,0">
                  <Button Content="Add" Click="AddMediaAsset_Click" Margin="0,0,4,4" />
                  <Button Content="Rename" Click="RenameMediaAsset_Click" IsEnabled="{Binding CanEditSelectedMediaAsset}" Margin="4,0,0,4" />
                  <Button Content="Delete" Click="DeleteMediaAsset_Click" IsEnabled="{Binding CanEditSelectedMediaAsset}" Margin="0,4,4,0" />
                  <Button Content="Remove unused" Click="RemoveUnusedMediaAssets_Click" Margin="4,4,0,0" />
                </UniformGrid>
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>

      <Border Grid.Row="0" Grid.Column="1" Margin="8,0" Background="White" BorderBrush="#d3d8df" BorderThickness="1">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Background="#d0d6f5" Padding="8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <TextBlock Text="Timeline Viewer / Editor" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Grid" Margin="0,0,6,0" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2"
                        ItemsSource="{Binding EditorGridDivisions}"
                        SelectedItem="{Binding EditorGridDivision, Mode=TwoWay}"
                        MinWidth="72"
                        Margin="0,0,8,0" />
            </Grid>
          </Border>
          <ScrollViewer x:Name="EditorTimelineScrollViewer"
                        Grid.Row="1"
                        Loaded="EditorTimelineScrollViewer_Loaded"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <controls:TimelineCanvas x:Name="EditorTimelineCanvas"
                                     Items="{Binding Timeline}"
                                     MeasureGridLines="{Binding MeasureGridLines}"
                                     PlayheadTick="0"
                                     StartTick="{Binding EditorTimelineStartTick}"
                                     GridTicks="{Binding EditorGridTicks}"
                                     SelectedTick="{Binding EditorSelectedTick}"
                                     SelectedLane="{Binding EditorSelectedLane}"
                                     SizeChanged="EditorTimelineCanvas_SizeChanged"
                                     Height="{Binding EditorTimelineHeight}" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!--
      <Border Grid.Row="0" Grid.Column="2" Background="White" BorderBrush="#d3d8df" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="Direct Input" Foreground="#111827" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

          <Grid Grid.Row="1" ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tick" Foreground="#111827" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftTick}" Foreground="#111827" Background="White" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lane" Foreground="#111827" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftLane}" Watermark="key1" Foreground="#111827" Background="White" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Type" Foreground="#111827" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftType}" Watermark="tap / hold" Foreground="#111827" Background="White" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="AudioId" Foreground="#111827" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DraftAudioId}" Foreground="#111827" Background="White" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Duration" Foreground="#111827" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DraftDurationTicks}" Foreground="#111827" Background="White" />
          </Grid>

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button Content="追加" Click="AddNote_Click" MinWidth="72" />
            <Button Content="反映" Click="ApplyNote_Click" MinWidth="72" />
            <Button Content="削除" Click="DeleteNote_Click" MinWidth="72" />
          </StackPanel>

          <TabControl Grid.Row="3">
            <TabItem Header="拡張">
              <ListBox ItemsSource="{Binding Extensions}" Foreground="#111827" Background="White" />
            </TabItem>
            <TabItem Header="Rights">
              <Grid Margin="8" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="License" Foreground="#111827" />
                <TextBox Grid.Row="1" Text="{Binding LicenseText}" AcceptsReturn="True" TextWrapping="Wrap" Foreground="#111827" Background="White" />
              </Grid>
            </TabItem>
          </TabControl>
        </Grid>
      </Border>
      -->
    </Grid>
  </DockPanel>
</Window>
