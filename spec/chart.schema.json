{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nbms/0.1/chart.schema.json",
  "title": "NBMS Chart",
  "description": "JSON Schema for NBMS .nbmc chart files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "chartId",
    "mode",
    "resolution",
    "lanes",
    "timing",
    "notes"
  ],
  "properties": {
    "format": {
      "const": "NBMS-CHART"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "chartId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "beat-5k",
        "beat-7k",
        "beat-10k",
        "beat-14k",
        "popn-9k",
        "custom"
      ]
    },
    "resolution": {
      "type": "integer",
      "minimum": 1
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "index"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/laneId"
          },
          "type": {
            "type": "string",
            "enum": [
              "key",
              "scratch",
              "background-audio",
              "pedal",
              "special"
            ]
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "positionHint": {
            "type": "string",
            "enum": [
              "left",
              "right",
              "playable",
              "background"
            ]
          }
        }
      }
    },
    "timing": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/bpmEvent"
          },
          {
            "$ref": "#/$defs/barEvent"
          },
          {
            "$ref": "#/$defs/stopEvent"
          },
          {
            "$ref": "#/$defs/scrollEvent"
          }
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/tapNote"
          },
          {
            "$ref": "#/$defs/longNote"
          },
          {
            "$ref": "#/$defs/mineNote"
          }
        ]
      }
    },
    "backgroundAudio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "audioId"
        ],
        "properties": {
          "tick": {
            "$ref": "#/$defs/tick"
          },
          "audioId": {
            "$ref": "#/$defs/audioId"
          },
          "lane": {
            "$ref": "#/$defs/laneId"
          },
          "volume": {
            "$ref": "#/$defs/volume"
          },
          "pan": {
            "$ref": "#/$defs/pan"
          }
        }
      }
    },
    "mediaEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tick",
          "mediaId",
          "type"
        ],
        "properties": {
          "tick": {
            "$ref": "#/$defs/tick"
          },
          "mediaId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "layer",
              "poor",
              "banner",
              "stagefile",
              "clear"
            ]
          },
          "layer": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "tick": {
      "type": "integer",
      "minimum": 0
    },
    "audioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "laneId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 1
    },
    "pan": {
      "type": "number",
      "minimum": -1,
      "maximum": 1,
      "default": 0
    },
    "baseTimingEvent": {
      "type": "object",
      "required": [
        "tick",
        "type"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "type": {
          "type": "string"
        }
      }
    },
    "bpmEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/baseTimingEvent"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tick",
            "type",
            "value"
          ],
          "properties": {
            "tick": {
              "$ref": "#/$defs/tick"
            },
            "type": {
              "const": "bpm"
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "barEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "type"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "type": {
          "const": "bar"
        }
      }
    },
    "stopEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "type",
        "durationTicks"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "type": {
          "const": "stop"
        },
        "durationTicks": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scrollEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "type",
        "value"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "type": {
          "const": "scroll"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "baseNote": {
      "type": "object",
      "required": [
        "tick",
        "lane",
        "type"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "lane": {
          "$ref": "#/$defs/laneId"
        },
        "type": {
          "type": "string"
        },
        "audioId": {
          "$ref": "#/$defs/audioId"
        },
        "volume": {
          "$ref": "#/$defs/volume"
        },
        "pan": {
          "$ref": "#/$defs/pan"
        }
      }
    },
    "tapNote": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNote"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tick",
            "lane",
            "type"
          ],
          "properties": {
            "tick": {
              "$ref": "#/$defs/tick"
            },
            "lane": {
              "$ref": "#/$defs/laneId"
            },
            "type": {
              "const": "tap"
            },
            "audioId": {
              "$ref": "#/$defs/audioId"
            },
            "volume": {
              "$ref": "#/$defs/volume"
            },
            "pan": {
              "$ref": "#/$defs/pan"
            }
          }
        }
      ]
    },
    "longNote": {
      "allOf": [
        {
          "$ref": "#/$defs/baseNote"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tick",
            "lane",
            "type",
            "durationTicks"
          ],
          "properties": {
            "tick": {
              "$ref": "#/$defs/tick"
            },
            "lane": {
              "$ref": "#/$defs/laneId"
            },
            "type": {
              "const": "long"
            },
            "durationTicks": {
              "type": "integer",
              "minimum": 1
            },
            "audioId": {
              "$ref": "#/$defs/audioId"
            },
            "volume": {
              "$ref": "#/$defs/volume"
            },
            "pan": {
              "$ref": "#/$defs/pan"
            }
          }
        }
      ]
    },
    "mineNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "lane",
        "type"
      ],
      "properties": {
        "tick": {
          "$ref": "#/$defs/tick"
        },
        "lane": {
          "$ref": "#/$defs/laneId"
        },
        "type": {
          "const": "mine"
        }
      }
    }
  }
}
